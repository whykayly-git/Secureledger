            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Includes at least one entry', function () { pm.expect(pm.response.json().entries.length).to.be.above(0); });"
