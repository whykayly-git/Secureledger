                  "pm.test('Name was updated', function () { pm.expect(pm.response.json().account.name).to.eql('Cash on Hand'); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Journal Entries",
      "item": [
        {
          "name": "Post Journal Entry — failure (unbalanced)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"date\": \"2026-01-01\",\n  \"description\": \"Unbalanced entry\",\n  \"lines\": [\n    { \"accountId\": \"{{expenseAccountId}}\", \"debit\": 100, \"credit\": 0 },\n    { \"accountId\": \"{{cashAccountId}}\", \"debit\": 0, \"credit\": 40 }\n  ]\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/journal-entries", "host": ["{{baseUrl}}"], "path": ["api", "journal-entries"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 400 (debits != credits)', function () { pm.response.to.have.status(400); });",
                  "pm.test('Error message mentions debits/credits', function () { pm.expect(pm.response.json().error).to.match(/credit/i); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Post Journal Entry — success",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"date\": \"2026-01-01\",\n  \"description\": \"Postman test entry\",\n  \"lines\": [\n    { \"accountId\": \"{{expenseAccountId}}\", \"debit\": 50, \"credit\": 0 },\n    { \"accountId\": \"{{cashAccountId}}\", \"debit\": 0, \"credit\": 50 }\n  ]\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/journal-entries", "host": ["{{baseUrl}}"], "path": ["api", "journal-entries"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201', function () { pm.response.to.have.status(201); });",
                  "const json = pm.response.json();",
                  "pm.test('Entry is POSTED', function () { pm.expect(json.journalEntry.status).to.eql('POSTED'); });",
                  "pm.environment.set('journalEntryId', json.journalEntry.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "List Journal Entries — success",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/journal-entries", "host": ["{{baseUrl}}"], "path": ["api", "journal-entries"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Includes a hash-chain entry for the posted journal entry', function () {",
                  "  const entries = pm.response.json().journalEntries;",
                  "  const match = entries.find(e => e.id === pm.environment.get('journalEntryId'));",
                  "  pm.expect(match).to.not.be.undefined;",
                  "  pm.expect(match.chain).to.not.be.null;",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4. Invoices",
      "item": [
        {
          "name": "Create Invoice — failure (missing receivable account)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerName\": \"Acme Co\",\n  \"dueDate\": \"2026-02-01\",\n  \"items\": [\n    { \"description\": \"Consulting\", \"quantity\": 1, \"unitPrice\": 100, \"incomeAccountId\": \"{{incomeAccountId}}\" }\n  ]\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/invoices", "host": ["{{baseUrl}}"], "path": ["api", "invoices"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 400 (missing receivableAccountId)', function () { pm.response.to.have.status(400); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Create Invoice — success",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerName\": \"Acme Co\",\n  \"dueDate\": \"2026-02-01\",\n  \"receivableAccountId\": \"{{cashAccountId}}\",\n  \"items\": [\n    { \"description\": \"Consulting\", \"quantity\": 1, \"unitPrice\": 100, \"incomeAccountId\": \"{{incomeAccountId}}\" }\n  ]\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/invoices", "host": ["{{baseUrl}}"], "path": ["api", "invoices"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201', function () { pm.response.to.have.status(201); });",
                  "const json = pm.response.json();",
                  "pm.test('Invoice is DRAFT with amount 100', function () {",
                  "  pm.expect(json.invoice.status).to.eql('DRAFT');",
                  "  pm.expect(Number(json.invoice.amount)).to.eql(100);",
                  "});",
                  "pm.environment.set('invoiceId', json.invoice.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Issue Invoice — success",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"action\": \"issue\"\n}" },
            "url": {
              "raw": "{{baseUrl}}/api/invoices/{{invoiceId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "invoices", "{{invoiceId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Invoice is now ISSUED', function () { pm.expect(pm.response.json().invoice.status).to.eql('ISSUED'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Issue Invoice — failure (already issued)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"action\": \"issue\"\n}" },
            "url": {
              "raw": "{{baseUrl}}/api/invoices/{{invoiceId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "invoices", "{{invoiceId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 409 (only draft invoices can be issued)', function () { pm.response.to.have.status(409); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Pay Invoice — success",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"action\": \"pay\",\n  \"cashAccountId\": \"{{cashAccountId}}\"\n}" },
            "url": {
              "raw": "{{baseUrl}}/api/invoices/{{invoiceId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "invoices", "{{invoiceId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Invoice is now PAID', function () { pm.expect(pm.response.json().invoice.status).to.eql('PAID'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "List Invoices — success",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/invoices", "host": ["{{baseUrl}}"], "path": ["api", "invoices"] }
