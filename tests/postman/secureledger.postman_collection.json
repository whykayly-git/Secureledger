          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201', function () { pm.response.to.have.status(201); });",
                  "const json = pm.response.json();",
                  "pm.test('Returns the created account', function () { pm.expect(json.account.type).to.eql('ASSET'); });",
                  "pm.environment.set('cashAccountId', json.account.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create Expense Account — success",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Office Supplies\",\n  \"type\": \"EXPENSE\",\n  \"code\": \"5000-{{$timestamp}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/accounts", "host": ["{{baseUrl}}"], "path": ["api", "accounts"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201', function () { pm.response.to.have.status(201); });",
                  "pm.environment.set('expenseAccountId', pm.response.json().account.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create Income Account — success",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Consulting Revenue\",\n  \"type\": \"INCOME\",\n  \"code\": \"4000-{{$timestamp}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/accounts", "host": ["{{baseUrl}}"], "path": ["api", "accounts"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201', function () { pm.response.to.have.status(201); });",
                  "pm.environment.set('incomeAccountId', pm.response.json().account.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "List Accounts — success",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/accounts", "host": ["{{baseUrl}}"], "path": ["api", "accounts"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Includes the accounts just created', function () {",
                  "  const ids = pm.response.json().accounts.map(a => a.id);",
                  "  pm.expect(ids).to.include(pm.environment.get('cashAccountId'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Update Account — success",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Cash on Hand\"\n}" },
            "url": {
              "raw": "{{baseUrl}}/api/accounts/{{cashAccountId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "accounts", "{{cashAccountId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
