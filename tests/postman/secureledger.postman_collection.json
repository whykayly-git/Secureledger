{
  "info": {
    "name": "SecureLedger API",
    "description": "Integration test collection for SecureLedger. Run against a live instance (see /tests/postman/README.md). Every endpoint has a success case and at least one expected-failure case. Uses the app's real httpOnly cookie session (Postman/Newman's cookie jar carries it automatically across requests within one run) plus a captured JWT copy in an environment variable for explicit invalid/expired-token tests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.environment.get('testEmail')) {",
          "  pm.environment.set('testEmail', 'qa+' + Date.now() + '@example.com');",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Register — success",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"organisationName\": \"Postman Test Org\",\n  \"name\": \"Postman Tester\",\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.test('Response includes the created user and organisation', function () {",
                  "  pm.expect(json.user.email).to.eql(pm.environment.get('testEmail'));",
                  "  pm.expect(json.user.role).to.eql('ACCOUNTANT');",
                  "  pm.expect(json.organisation.name).to.eql('Postman Test Org');",
                  "});",
                  "pm.test('Sets the session cookie', function () {",
                  "  pm.expect(pm.cookies.has('secureledger_session')).to.be.true;",
                  "});",
                  "pm.environment.set('jwt_token', pm.cookies.get('secureledger_session'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Register — failure (duplicate email)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"organisationName\": \"Another Org\",\n  \"name\": \"Someone Else\",\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 409 (email already registered)', function () { pm.response.to.have.status(409); });",
                  "pm.test('Response includes an error message', function () { pm.expect(pm.response.json().error).to.be.a('string'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/api/auth/logout", "host": ["{{baseUrl}}"], "path": ["api", "auth", "logout"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('Status code is 200', function () { pm.response.to.have.status(200); });"]
              }
            }
          ]
        },
        {
          "name": "Me — failure (unauthenticated)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/auth/me", "host": ["{{baseUrl}}"], "path": ["api", "auth", "me"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 401 when not authenticated', function () { pm.response.to.have.status(401); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Login — failure (wrong password)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"the-wrong-password\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 401 for wrong password', function () { pm.response.to.have.status(401); });",
                  "pm.test('Does not reveal whether the email exists', function () { pm.expect(pm.response.json().error).to.eql('Invalid email or password'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Login — success",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Returns the logged-in user', function () { pm.expect(pm.response.json().user.email).to.eql(pm.environment.get('testEmail')); });",
                  "pm.environment.set('jwt_token', pm.cookies.get('secureledger_session'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Me — success (authenticated)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/auth/me", "host": ["{{baseUrl}}"], "path": ["api", "auth", "me"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Returns the current session user and role', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.user.email).to.eql(pm.environment.get('testEmail'));",
                  "  pm.expect(json.user.role).to.eql('ACCOUNTANT');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Accounts",
      "item": [
        {
          "name": "Create Account — failure (missing fields)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Incomplete Account\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/accounts", "host": ["{{baseUrl}}"], "path": ["api", "accounts"] }
          },
          "event": [
