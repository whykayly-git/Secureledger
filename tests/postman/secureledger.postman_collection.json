                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 400 (missing type/code)', function () { pm.response.to.have.status(400); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Create Cash Account — success",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Cash\",\n  \"type\": \"ASSET\",\n  \"code\": \"1000-{{$timestamp}}\"\n}"
