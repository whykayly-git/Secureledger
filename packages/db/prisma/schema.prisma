generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  BOOKKEEPER
  ACCOUNTANT
  AUDITOR
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

enum JournalEntryStatus {
  DRAFT
  POSTED
  VOID
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  VOIDED
}

enum LedgerRecordType {
  JOURNAL_ENTRY
  INVOICE
}

model Organisation {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users           User[]
  accounts        Account[]
  journalEntries  JournalEntry[]
  invoices        Invoice[]
  ledgerChain     LedgerChain[]
  ledgerCheckpoints LedgerCheckpoint[]
  adminActionLogs AdminActionLog[]
  verificationRuns VerificationRun[]

  @@map("organisations")
}

model User {
  id             String   @id @default(uuid())
  name           String
  email          String   @unique
  passwordHash   String
  role           Role     @default(BOOKKEEPER)
  organisationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Staff management (Manage Staff module). isOrgAdmin is a separate
  // dimension from `role` — an organisation-admin flag, not an accounting
  // role — because any of the existing accounting roles can also be
  // trusted to manage staff. The first user registered for a NEW
  // organisation (via /register) is always isOrgAdmin = true.
  isOrgAdmin     Boolean   @default(false)
  // A deactivated user cannot log in, but their historical
  // JournalEntry/Invoice/LedgerChain references and AdminActionLog
  // entries must keep displaying correctly — so this is a flag, never a
  // delete.
  isActive       Boolean   @default(true)
  lastLoginAt    DateTime?

  organisation   Organisation    @relation(fields: [organisationId], references: [id])
  journalEntries JournalEntry[]  @relation("CreatedByUser")
  voidedJournalEntries JournalEntry[] @relation("VoidedByUser")
  voidedInvoices Invoice[]       @relation("InvoiceVoidedByUser")
  passwordResetTokens PasswordResetToken[]
  adminActionLogs AdminActionLog[]

  @@index([organisationId])
  @@map("users")
}

model Account {
  id             String      @id @default(uuid())
  organisationId String
  name           String
  type           AccountType
  code           String
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organisation   Organisation      @relation(fields: [organisationId], references: [id])
  journalLines   JournalLine[]

  @@unique([organisationId, code])
  @@index([organisationId])
  @@map("accounts")
}

model JournalEntry {
  id             String             @id @default(uuid())
  organisationId String
  date           DateTime
  description    String
  status         JournalEntryStatus @default(DRAFT)
  createdById    String
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  // Void (posted entries only): original data/hash/chain position are
  // never touched — voiding only sets these flag fields and posts a
  // separate reversing entry.
  voidedByUserId String?
  voidedAt       DateTime?
  voidReason     String?

  // Set on the REVERSING entry, pointing back at the original entry it
  // reverses. An original entry can be reversed at most once.
  reversalOfEntryId String? @unique

  organisation   Organisation   @relation(fields: [organisationId], references: [id])
  createdBy      User           @relation("CreatedByUser", fields: [createdById], references: [id])
  voidedByUser   User?          @relation("VoidedByUser", fields: [voidedByUserId], references: [id])
  lines          JournalLine[]
  invoices       Invoice[]

  reversalOfEntry JournalEntry?  @relation("JournalEntryReversal", fields: [reversalOfEntryId], references: [id])
  reversedByEntry JournalEntry?  @relation("JournalEntryReversal")

  @@index([organisationId])
  @@index([organisationId, date])
  @@map("journal_entries")
}

model JournalLine {
  id             String   @id @default(uuid())
  journalEntryId String
  accountId      String
  debit          Decimal  @default(0) @db.Decimal(18, 2)
  credit         Decimal  @default(0) @db.Decimal(18, 2)
  memo           String?

  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account        Account      @relation(fields: [accountId], references: [id])

  @@index([journalEntryId])
  @@index([accountId])
  @@map("journal_lines")
}

model Invoice {
  id                   String        @id @default(uuid())
  organisationId       String
  customerName         String
  lineItems            Json
  amount               Decimal       @db.Decimal(18, 2)
  status               InvoiceStatus @default(DRAFT)
  dueDate              DateTime
  relatedJournalEntryId String?      @unique
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  // Void (issued/paid invoices only): original data/amount/lineItems and
  // hash-chain position are never touched — voiding only sets these flag
  // fields and posts a separate reversing JournalEntry.
  voidedByUserId String?
  voidedAt       DateTime?
  voidReason     String?

  organisation         Organisation  @relation(fields: [organisationId], references: [id])
  relatedJournalEntry   JournalEntry? @relation(fields: [relatedJournalEntryId], references: [id])
  voidedByUser          User?         @relation("InvoiceVoidedByUser", fields: [voidedByUserId], references: [id])

  @@index([organisationId])
  @@map("invoices")
}

// NOTE ON A CONSTRAINT NOT REPRESENTABLE HERE: migration
// 20260923000000_org_scoping_and_duplicate_recordid adds a raw-SQL PARTIAL
// unique index — UNIQUE (organisationId, recordId) WHERE recordType =
// 'JOURNAL_ENTRY' — that Prisma's schema DSL has no syntax for, so it can't
// be declared as an `@@unique` here without the index also (incorrectly)
// covering INVOICE rows. It exists to close a real tamper scenario: an
// attacker inserting a second LedgerChain row that duplicates a reference
// to an already-chained, unaltered JournalEntry. It is JOURNAL_ENTRY-only
// on purpose — a JournalEntry gets exactly one legitimate chain entry ever,
// but the SAME Invoice legitimately gets several over its lifecycle (issue,
// pay, void each call appendLedgerChainEntry again with the same recordId;
// see apps/web/app/api/invoices/[id]/route.ts) — a blanket
// (organisationId, recordType, recordId) unique constraint would reject
// those legitimate transitions.
model LedgerChain {
  id             String            @id @default(uuid())
  organisationId String
  recordType     LedgerRecordType
  recordId       String
  hash           String
  previousHash   String?
  checkpointId   String?
  createdAt      DateTime          @default(now())

  // Explicit, monotonically increasing position within this organisation's
  // chain (1, 2, 3, ...), assigned at write time in appendLedgerChainEntry
  // under the same per-organisation advisory lock that already serializes
  // writes. Exists because createdAt alone is a mutable timestamp column
  // like any other — sequenceNumber gives verifyChainContinuity a
  // mechanically checkable notion of "position" that is independent of it,
  // so a gap (a deleted row) or a reorder shows up as a broken 1..N
  // sequence rather than relying on timestamp ordering alone.
  sequenceNumber Int

  organisation   Organisation      @relation(fields: [organisationId], references: [id])
  checkpoint     LedgerCheckpoint? @relation(fields: [checkpointId], references: [id])

  @@unique([organisationId, sequenceNumber])
  @@index([organisationId, createdAt])
  @@index([organisationId, checkpointId])
  @@index([recordType, recordId])
  @@index([checkpointId, createdAt])
  @@map("ledger_chain")
}

model LedgerCheckpoint {
  id             String   @id @default(uuid())
  organisationId String
  merkleRoot     String
  signature      String
  rangeStart     DateTime
  rangeEnd       DateTime
  createdAt      DateTime @default(now())

  // Persisted count of LedgerChain rows originally included in this
  // checkpoint's Merkle batch, set once at checkpoint-creation time from
  // the same batch buildCheckpointPayload signed over. Lets
  // verifyChainContinuity detect a deleted row (including the batch's own
  // tip) purely by comparing this to COUNT(*) of surviving rows that still
  // reference this checkpoint — independent of, and a check beyond, the
  // per-record Merkle inclusion check.
  recordCount    Int

  organisation   Organisation  @relation(fields: [organisationId], references: [id])
  chainEntries   LedgerChain[]

  @@index([organisationId, createdAt])
  @@map("ledger_checkpoints")
}

/// Single-use, short-expiry password reset tokens. Only a SHA-256 hash of
/// the token is ever stored (same principle as bcrypt-hashed passwords —
/// the raw token is never persisted, only handed to the user once).
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user      User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("password_reset_tokens")
}

/// Generic audit trail for non-ledger administrative actions (e.g.
/// deleting a draft journal entry or draft invoice, neither of which was
/// ever hash-chained, so they can't appear in the LedgerChain-based
/// /audit-log the way posted/voided records do).
model AdminActionLog {
  id             String   @id @default(uuid())
  organisationId String
  // Nullable, with onDelete: SetNull — a staff member who is later hard-
  // deleted (Manage Staff → Remove) may themselves have been the ACTOR of
  // earlier admin actions (they invited someone, changed a role, etc.).
  // The log row must survive their removal for audit-trail integrity;
  // only the actor reference is cleared. targetId is a plain string, not
  // a foreign key, so a removed user showing up as a TARGET (e.g. their
  // own "REMOVE_STAFF" entry) was already fine without this.
  userId         String?
  action         String
  targetType     String
  targetId       String
  metadata       Json?
  createdAt      DateTime @default(now())

  organisation   Organisation @relation(fields: [organisationId], references: [id])
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organisationId, createdAt])
  @@map("admin_action_logs")
}

/// One full verification of an organisation's ledger: every chain row run
/// through the real verifier plus the continuity sweep. Written by the
/// checkpoint worker on a schedule (source SCHEDULED) and by the auditor's
/// "Verify all" button (source MANUAL). A run with failed records or chain
/// gaps carries a problemSignature, a hash of exactly what was found, so an
/// auditor's acknowledgement stays valid until the findings change.
model VerificationRun {
  id                   String    @id @default(uuid())
  organisationId       String
  source               String
  createdAt            DateTime  @default(now())
  durationMs           Int
  totalRecords         Int
  checkedRecords       Int
  verifiedCount        Int
  pendingCount         Int
  failedCount          Int
  continuityIntact     Boolean
  gapCount             Int
  problemSignature     String?
  details              Json?
  acknowledgedAt       DateTime?
  // Plain string, not a foreign key, so removing the user later cannot
  // disturb the record of who acknowledged a finding.
  acknowledgedByUserId String?

  organisation         Organisation @relation(fields: [organisationId], references: [id])

  @@index([organisationId, createdAt])
  @@map("verification_runs")
}
