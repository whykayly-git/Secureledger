{
  "name": "@secureledger/checkpoint-worker",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cycle": {
      "types": "./dist/cycle.d.ts",
      "default": "./dist/cycle.js"
    },
    "./verificationCycle": {
      "types": "./dist/verificationCycle.d.ts",
      "default": "./dist/verificationCycle.js"
    },
    "./checkpoint": {
      "types": "./dist/checkpoint.d.ts",
      "default": "./dist/checkpoint.js"
    }
  },
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "jest"
  },
  "dependencies": {
    "@secureledger/crypto": "*",
    "@secureledger/db": "*",
    "@secureledger/ledger": "*",
    "@secureledger/verification": "*",
    "node-cron": "^3.0.3"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.15",
    "@types/node-cron": "^3.0.11",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.4",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.4"
  }
}
