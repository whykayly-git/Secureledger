DATABASE_URL=postgresql://secureledger:secureledger@localhost:5432/secureledger?schema=public

# ECDSA PRIVATE key (base64-encoded PEM, or a raw PEM with literal newlines).
# This value must exist ONLY in this service's environment — never in apps/web.
# Generate a fresh pair with: node ../../scripts/generate-checkpoint-keys.js
CHECKPOINT_PRIVATE_KEY=base64-encoded-PEM-private-key

CHECKPOINT_POLL_INTERVAL_MS=60000
CHECKPOINT_MAX_INTERVAL_MS=3600000
CHECKPOINT_BATCH_THRESHOLD=500
HEALTH_PORT=8081

# Must match the web app's value exactly. The worker checks every row's tag before signing.
LEDGER_AUTH_KEY=replace-with-64-random-hex-characters
