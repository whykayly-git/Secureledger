DATABASE_URL=postgresql://secureledger:secureledger@localhost:5432/secureledger?schema=public
JWT_SECRET=replace-with-a-long-random-string

# ECDSA PUBLIC key only (base64-encoded PEM, or a raw PEM with literal newlines).
# The matching private key must NEVER be set here — it belongs only to the
# checkpoint-worker. Generate both with: node ../../scripts/generate-checkpoint-keys.js
CHECKPOINT_PUBLIC_KEY=base64-encoded-PEM-public-key

# Comma-separated emails granted platform-admin access to /admin (all orgs, users, activity,
# "Open as admin"). An allowlist on purpose: no UI or API can grant it.
PLATFORM_ADMIN_EMAILS=you@example.com

# Authenticates every ledger row written by the app. Must match the checkpoint-worker's value.
# Never share it with the database. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LEDGER_AUTH_KEY=replace-with-64-random-hex-characters
