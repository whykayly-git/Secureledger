DATABASE_URL=postgresql://secureledger:secureledger@localhost:5432/secureledger?schema=public
# If your DB is the PGlite dev instance from `npm run dev:db` (see root README),
# use 127.0.0.1 instead of localhost and append &pgbouncer=true, e.g.:
# DATABASE_URL=postgresql://secureledger:secureledger@127.0.0.1:5432/secureledger?schema=public&pgbouncer=true

# CHECKPOINT_PUBLIC_KEY is NOT needed here — the test harness generates its
# own ECDSA key pair per suite run and installs the public half into
# process.env itself, so scenarios verify against a real key the harness
# actually signed with, not the app's real production key.
