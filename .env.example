# Used by docker-compose.yml to inject secrets into the web and
# checkpoint-worker containers. Copy to .env and fill in real values —
# generate the ECDSA key pair with: node scripts/generate-checkpoint-keys.js

JWT_SECRET=replace-with-a-long-random-string

# Public key goes to the web app (verification only).
CHECKPOINT_PUBLIC_KEY=base64-encoded-PEM-public-key

# Private key goes ONLY to the checkpoint-worker. Never put this in apps/web.
CHECKPOINT_PRIVATE_KEY=base64-encoded-PEM-private-key

# Authenticates every ledger row. Must be IDENTICAL for the web app and the checkpoint-worker,
# and must never be given to the database or anyone with only database access.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LEDGER_AUTH_KEY=replace-with-64-random-hex-characters
